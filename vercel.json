{
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend"
    },
    "backend": {
      "entrypoint": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
